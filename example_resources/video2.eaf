<?xml version='1.0' encoding='UTF-8'?>
<ANNOTATION_DOCUMENT AUTHOR="pympi" DATE="2026-10-18T21:09:04+02:00" VERSION="2.8" FORMAT="2.8" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.mpi.nl/tools/elan/EAFv2.8.xsd">
	<HEADER>
		<MEDIA_DESCRIPTOR MEDIA_URL="/Users/fheinrich/repos/video-compression-scripts/example_resources/video2.mp4" MIME_TYPE="video/mp4" />
		<MEDIA_DESCRIPTOR MEDIA_URL="/Users/fheinrich/repos/video-compression-scripts/example_resources/video2.wav" MIME_TYPE="audio/x-wav" />
		<PROPERTY NAME="lastUsedAnnotation">0</PROPERTY>
		</HEADER>
	<TIME_ORDER>
		<TIME_SLOT TIME_SLOT_ID="ts2" TIME_VALUE="600" />
		<TIME_SLOT TIME_SLOT_ID="ts3" TIME_VALUE="1200" />
		<TIME_SLOT TIME_SLOT_ID="ts4" TIME_VALUE="1500" />
		<TIME_SLOT TIME_SLOT_ID="ts5" TIME_VALUE="8000" />
		<TIME_SLOT TIME_SLOT_ID="ts6" TIME_VALUE="8600" />
		<TIME_SLOT TIME_SLOT_ID="ts7" TIME_VALUE="13900" />
		<TIME_SLOT TIME_SLOT_ID="ts8" TIME_VALUE="14200" />
		<TIME_SLOT TIME_SLOT_ID="ts9" TIME_VALUE="14800" />
		<TIME_SLOT TIME_SLOT_ID="ts10" TIME_VALUE="15000" />
		<TIME_SLOT TIME_SLOT_ID="ts11" TIME_VALUE="16400" />
		<TIME_SLOT TIME_SLOT_ID="ts12" TIME_VALUE="17300" />
		<TIME_SLOT TIME_SLOT_ID="ts13" TIME_VALUE="17900" />
		<TIME_SLOT TIME_SLOT_ID="ts14" TIME_VALUE="18200" />
		<TIME_SLOT TIME_SLOT_ID="ts15" TIME_VALUE="20900" />
		<TIME_SLOT TIME_SLOT_ID="ts16" TIME_VALUE="21600" />
		<TIME_SLOT TIME_SLOT_ID="ts17" TIME_VALUE="24000" />
		</TIME_ORDER>
	<TIER TIER_ID="default" LINGUISTIC_TYPE_REF="default-lt" />
	<TIER TIER_ID="Speech" LINGUISTIC_TYPE_REF="Speech">
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a2" TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts3">
				<ANNOTATION_VALUE>So...</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a3" TIME_SLOT_REF1="ts4" TIME_SLOT_REF2="ts5">
				<ANNOTATION_VALUE>And now we have two videos recording at the same time to demonstrate how we could synchronize videos</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4" TIME_SLOT_REF1="ts6" TIME_SLOT_REF2="ts7">
				<ANNOTATION_VALUE>1, 2, 3, 4, 5, 6, 7, 8. I hope this is helpful.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a5" TIME_SLOT_REF1="ts8" TIME_SLOT_REF2="ts9">
				<ANNOTATION_VALUE>Yeah.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a6" TIME_SLOT_REF1="ts10" TIME_SLOT_REF2="ts11">
				<ANNOTATION_VALUE>I'm going to stop this one now.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a7" TIME_SLOT_REF1="ts12" TIME_SLOT_REF2="ts13">
				<ANNOTATION_VALUE>and</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a8" TIME_SLOT_REF1="ts14" TIME_SLOT_REF2="ts15">
				<ANNOTATION_VALUE>I'll keep going with this other one, a bit just longer.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a9" TIME_SLOT_REF1="ts16" TIME_SLOT_REF2="ts17">
				<ANNOTATION_VALUE>Let's see how this works right.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		</TIER>
	<LINGUISTIC_TYPE LINGUISTIC_TYPE_ID="default-lt" TIME_ALIGNABLE="true" GRAPHIC_REFERENCES="false" />
	<LINGUISTIC_TYPE LINGUISTIC_TYPE_ID="Speech" TIME_ALIGNABLE="true" GRAPHIC_REFERENCES="false" />
	<CONSTRAINT STEREOTYPE="Time_Subdivision" DESCRIPTION="Time subdivision of parent annotation's time interval, no time gaps allowed within this interval" />
	<CONSTRAINT STEREOTYPE="Symbolic_Subdivision" DESCRIPTION="Symbolic subdivision of a parent annotation. Annotations refering to the same parent are ordered" />
	<CONSTRAINT STEREOTYPE="Symbolic_Association" DESCRIPTION="1-1 association with a parent annotation" />
	<CONSTRAINT STEREOTYPE="Included_In" DESCRIPTION="Time alignable annotations within the parent annotation's time interval, gaps are allowed" />
